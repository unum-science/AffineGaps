#!/usr/bin/env bash
#
# AffineGaps commit-msg hook - holds the subject line to the sanctioned verbs and keeps assistant
# attribution out of the history.

set -u
LC_ALL=C

message_file=$1
subject=$(sed -n '1p' "$message_file")
failed=0

# The verbs this repository actually uses, taken from its own log. `Fix:` for a defect, `Add:` for
# something that did not exist, `Improve:` for anything that did exist and got better - refactors
# included, since there is no `Refactor:`. `Chore:` for housekeeping that removes or rearranges,
# `Make:` for the build, `Docs:` for prose that drifted on its own, `Break:` for a change that
# breaks a published surface. `Merge:` is written by Git. A release is exactly `Release: vX.Y.Z` or
# `Release: vX.Y.Z-rc.N`, every staged version site must carry that version, and no other commit may
# change `VERSION`.
case "$subject" in
    # Releases are cut by hand, so this check is all that stands between a typo and a published package.
    "Release:"*)
        version=$(printf '%s\n' "$subject" | sed -nE 's/^Release: v([0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?)$/\1/p')
        if [ -z "$version" ]; then
            echo "commit-msg: a release subject is exactly 'Release: vX.Y.Z' or 'Release: vX.Y.Z-rc.N'." >&2
            echo "commit-msg: got: $subject" >&2
            failed=1
        else
            stale=""
            [ "$(git show :VERSION 2> /dev/null)" = "$version" ] || stale="$stale VERSION"
            git show :pyproject.toml 2> /dev/null | grep -qxF "version = \"$version\"" || stale="$stale pyproject.toml"
            git show :pixi.toml 2> /dev/null | grep -qxF "version = \"$version\"" || stale="$stale pixi.toml"
            git show :affinegaps.py 2> /dev/null | grep -qxF "__version__ = \"$version\"" || stale="$stale affinegaps.py"
            if [ -n "$stale" ]; then
                echo "commit-msg: these staged files don't carry $version:$stale" >&2
                failed=1
            fi
        fi
        ;;
    "Fix: "* | "Add: "* | "Improve: "* | "Chore: "* | "Make: "* | "Docs: "* | "Break: "*)
        if git diff --cached --name-only | grep -qx VERSION; then
            echo "commit-msg: VERSION only changes in a 'Release: vX.Y.Z' commit." >&2
            failed=1
        fi
        ;;
    "Merge: "* | "Revert "* | "fixup! "* | "squash! "*) ;;
    *)
        echo "commit-msg: the subject must start with one of the sanctioned verbs." >&2
        echo "commit-msg:   Fix: Add: Improve: Chore: Make: Docs: Break:" >&2
        echo "commit-msg: there is no 'Refactor:' - a refactor is an Improve:." >&2
        echo "commit-msg: got: $subject" >&2
        failed=1
        ;;
esac

# The harness appends these by default and they are not wanted in this history.
attribution=$(grep -inE 'co-authored-by:.*(claude|anthropic)|generated with \[?claude|Claude-Session:' "$message_file" || true)
if [ -n "$attribution" ]; then
    echo "commit-msg: assistant attribution must not appear in the message." >&2
    printf '%s\n' "$attribution" >&2
    failed=1
fi

exit $failed
